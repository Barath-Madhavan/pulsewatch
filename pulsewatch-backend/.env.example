PORT=8080
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pulsewatch?sslmode=disable

# Optional: email alerts are skipped (logged, not sent) until this is set
RESEND_API_KEY=
RESEND_FROM_EMAIL=PulseWatch <onboarding@resend.dev>

# Caps how many monitors can exist at once; 0 = unlimited
MAX_MONITORS=30
# When true, email/webhook sends are simulated (logged) instead of delivered
DEMO_MODE=false
